<?xml version="1.0" encoding="utf-8"?>
<!-- 権限の最小化（01_製品仕様書.md §12）:
     写真閲覧・取り込みに INTERNET 権限は一切追加しない。
     Photo Picker/SAF の選択結果 URI はシステムから渡されるため、広域ストレージ権限も不要。
     書き出しはユーザーが明示承認した出力 URI へのみ行う。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".ImageShotApplication"
        android:allowBackup="false"
        android:label="Image Shot"
        android:theme="@style/Theme.ImageShot"
        android:supportsRtl="true">

        <!-- Macrobenchmark が非 debuggable ビルドをプロファイル可能にするための最小タグ。
             権限・データアクセスの拡張なし（shell プロファイラのみ）。 -->
        <profileable android:shell="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection|screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|uiMode"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
